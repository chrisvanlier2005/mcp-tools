{
    "name": "lier/mcp-tools",
    "description": "Expose Laravel controller actions as MCP tools with the #[McpTool] attribute.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.9 || ^1.0",
        "webmozart/assert": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Lier\\McpTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lier\\McpTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lier\\McpTools\\McpToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
